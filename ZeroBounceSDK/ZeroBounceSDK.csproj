<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Title>ZeroBounce.SDK</Title>
        <Authors>ZeroBounceIntegrations</Authors>
		<PackageVersion>3.0.0</PackageVersion>
		<Version>3.0.0</Version>
		<Company>ZeroBounce</Company>
		<Description>Official ZeroBounce SDK for .NET: email validation and verification, AI scoring, email finder and domain search, bulk files, the Inbox Placement Tester and the Warmup API.</Description>
		<PackageProjectUrl>https://www.zerobounce.net/</PackageProjectUrl>
		<PackageIcon>zerobounce-logo.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/zerobounce/zero-bounce-csharp-sdk-setup</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>zerobounce;email-validation;email-verification;email-verifier;email-finder;ai-scoring;deliverability;sdk;api</PackageTags>
		<PackageId>ZeroBounce.SDK</PackageId>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<!-- IntelliSense: ship ZeroBounceSDK.xml in the package. -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<!-- Not every public member or parameter has a doc comment yet. -->
		<NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
		<!-- Debugging: a .snupkg symbols package, with SourceLink pointing at GitHub. -->
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
		<!-- CA2007 (ConfigureAwait) is an error in this project, see .editorconfig. -->
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
    </PropertyGroup>

    <ItemGroup>
      <None Include="..\zerobounce-logo.png">
        <Pack>True</Pack>
        <PackagePath>\</PackagePath>
      </None>
      <None Include="..\README.md">
        <Pack>True</Pack>
        <PackagePath>\</PackagePath>
      </None>
    </ItemGroup>

    <ItemGroup>
      <AssemblyMetadata Include="ZeroBounce.PackageVersion" Value="$(PackageVersion)" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
      <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="All" />
    </ItemGroup>

</Project>

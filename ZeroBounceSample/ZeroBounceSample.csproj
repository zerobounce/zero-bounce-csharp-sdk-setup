<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A WPF sample that calls the SDK from the UI thread, which is the case the
    SDK's SynchronizationContext handling exists for. It builds against the SDK
    in this repository, not a published package.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Lets CI build (not run) the sample on Linux. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Properties/AssemblyInfo.cs carries the assembly attributes. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZeroBounceSDK\ZeroBounceSDK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="email_file.csv">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
